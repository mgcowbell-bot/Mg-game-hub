rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isSignedIn() && 
             request.auth.token.email == "mgcowbell@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    function isValidGame(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.slug is string && data.slug.size() <= 128 &&
             data.category is string &&
             data.version is string && data.version.size() <= 20 &&
             data.apkUrl is string &&
             data.published is bool;
    }

    // Games collection: Public can read published games; Only admin (mgcowbell@gmail.com) can post/manage APKs
    match /games/{gameId} {
      allow get, list: if resource.data.published == true || isMasterAdmin();
      allow create: if isMasterAdmin() && isValidId(gameId) && isValidGame(request.resource.data);
      allow update: if isMasterAdmin() && isValidGame(request.resource.data);
      allow delete: if isMasterAdmin();
    }

    // Downloads collection: Atomic logging of download stats
    match /downloads/{downloadId} {
      allow create: if isValidId(downloadId) &&
                       request.resource.data.gameId is string &&
                       request.resource.data.timestamp is string;
      allow read: if isMasterAdmin();
    }
  }
}
